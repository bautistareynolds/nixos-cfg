// Fix the "HEllo" bug: by default XKB turns Caps Lock OFF on key *release*,
// so typing fast (next key pressed before Caps is released) still comes out uppercase.
// unlockOnPress makes it turn off on *press*, like Windows/macOS.
// Needs libxkbcommon >= 1.11 and a compositor using keymap format v2 (Hyprland >= 0.55 does).
partial xkb_compatibility "caps_unlock_on_press" {
    interpret Caps_Lock {
        action = LockMods(modifiers = Lock, unlockOnPress = true);
    };
};
